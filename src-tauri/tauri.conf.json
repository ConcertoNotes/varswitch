{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "VarSwitch",
  "version": "3.2.3",
  "identifier": "com.varswitch.desktop",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "node dev-server.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "VarSwitch",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "varswitch"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1MUIwNTMxQjI1NURDNTQKUldSVTNGV3lNUVViNVNxUmxaL1UyNUxmUDJMSlZqSzZjajdvVEdKREJsdlFOa0hCOVlYQURDdE0K",
      "endpoints": [
        "https://download.varswitch.strova.top/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
